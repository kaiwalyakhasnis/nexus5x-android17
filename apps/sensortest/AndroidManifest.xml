<?xml version="1.0" encoding="utf-8"?>
<!-- Sensor Test: every sensor Android reports, with its properties and live
     values, through the standard SensorManager API only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.nexus5x.sensortest"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="35" />

    <!-- step counter/detector -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- sampling faster than 200 Hz -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <application android:label="Sensor Test" android:theme="@android:style/Theme.DeviceDefault">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
