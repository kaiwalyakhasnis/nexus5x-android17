# Android 17 (GSI) on top of nexus5x-linux-6.12-wip/scripts/kernel.config.
#
# Modelled on ACK's kernel/configs android-base.config, with one twist: LK only
# loads ~29.5 MiB of kernel (Image + BSS), and the Ubuntu kernel already uses
# 27.3 MiB of it. So only what must exist before the vendor image is mounted
# is built in (binder, SELinux, PSI, ...). The networking stack Android's netd
# wants (IPv6, netfilter/xtables, xfrm, traffic control) is =m and is loaded
# from /vendor/lib/modules by the ramdisk's /init, before Android's init runs.

# --- binder: binderfs creates the three devices at mount (init.rc mounts it
# on /dev/binderfs and symlinks /dev/binder, /dev/hwbinder, /dev/vndbinder)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# --- SELinux: Android's init refuses to boot without it (and a user-build GSI
# is always enforcing; the vendor policy makes domains permissive instead)
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="selinux"
CONFIG_AUDIT=y
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_IMA is not set
# CONFIG_EVM is not set

# --- cgroups: Android's cgroups.json still mounts cpuset (and memcg where
# present) as v1 controllers, which 6.12 only builds with these
CONFIG_CPUSETS=y
CONFIG_CPUSETS_V1=y
CONFIG_MEMCG=y
CONFIG_MEMCG_V1=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y

# --- what Android's userspace relies on
# lmkd: memory pressure from PSI triggers
CONFIG_PSI=y
# ART's concurrent mark-compact GC
CONFIG_USERFAULTFD=y
# MediaProvider (/sdcard) is a FUSE daemon
CONFIG_FUSE_FS=y
# installd's storage stats, the fstab "quota" flag
CONFIG_QUOTA=y
CONFIG_QUOTACTL=y
CONFIG_QFMT_V2=y
# gralloc (minigbm) and codecs allocate from DMA-BUF heaps (ION is gone)
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_SW_SYNC=y
# input HALs and adb/scrcpy-style input injection
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_MISC=y
# suspend blockers from userspace (/sys/power/wake_lock)
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_GC=y
# file-based encryption and fs-verity (APK verity), for later
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
# Android uses its own IPC instead
# CONFIG_SYSVIPC is not set
CONFIG_TUN=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FHANDLE=y

# --- apexd: APEX payloads are ext4 images on loop devices, and the
# decompressed .capex ones on /data are mounted through dm-verity
CONFIG_BLK_DEV_LOOP=y
# some APEX payloads are EROFS (com.android.virt in the 17 QPR1 GSI), and
# apexd-bootstrap reboots the phone when one fails to mount
CONFIG_EROFS_FS=m
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_VERITY=m
CONFIG_DM_CRYPT=m

# --- eBPF: netd/netbpfload attach cgroup and tc programs
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m

# --- networking for netd, as modules on /vendor (see top)
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_INET_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6=m
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_MIP6=m
CONFIG_IPV6_VTI=m
CONFIG_INET_ESP=m
CONFIG_INET6_ESP=m
CONFIG_INET6_IPCOMP=m
CONFIG_XFRM_USER=m
CONFIG_XFRM_INTERFACE=m
CONFIG_XFRM_MIGRATE=y
CONFIG_XFRM_STATISTICS=y
CONFIG_NET_KEY=m
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_CONNTRACK_SECMARK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CT_NETLINK=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=m
CONFIG_NETFILTER_XT_TARGET_MARK=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=m
CONFIG_NETFILTER_XT_TARGET_SECMARK=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NETFILTER_XT_TARGET_TRACE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_HELPER=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_LENGTH=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MAC=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_POLICY=m
CONFIG_NETFILTER_XT_MATCH_QUOTA=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MATCH_STRING=m
CONFIG_NETFILTER_XT_MATCH_TIME=m
CONFIG_NETFILTER_XT_MATCH_U32=m
CONFIG_NF_TPROXY_IPV4=m
CONFIG_NF_TPROXY_IPV6=m
CONFIG_NF_SOCKET_IPV4=m
CONFIG_NF_SOCKET_IPV6=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_SECURITY=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_MATCH_ECN=m
CONFIG_IP_NF_MATCH_TTL=m
CONFIG_IP_NF_ARPTABLES=m
CONFIG_IP_NF_ARPFILTER=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_U32=m
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_U32=m

# a stable module directory name (no git hash: the patches are re-applied,
# with new commit ids, on every build)
# CONFIG_LOCALVERSION_AUTO is not set
