 drivers/staging/nanohub/comms.h  |   92 +++
 drivers/staging/nanohub/main.c   | 1012 ++++++++++++++++++++++++++++++
 drivers/staging/nanohub/main.h   |  141 +++++
 drivers/staging/nanohub/spi.c    |  289 +++++++++
 9 files changed, 1855 insertions(+)
 create mode 100644 drivers/staging/nanohub/Kconfig
 create mode 100644 drivers/staging/nanohub/Makefile
 create mode 100644 drivers/staging/nanohub/comms.c
 create mode 100644 drivers/staging/nanohub/comms.h
 create mode 100644 drivers/staging/nanohub/main.c
 create mode 100644 drivers/staging/nanohub/main.h
 create mode 100644 drivers/staging/nanohub/spi.c

